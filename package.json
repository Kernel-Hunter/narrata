{
  "name": "narrata",
  "version": "0.1.0",
  "private": true,
  "description": "Reads anything aloud with a natural voice that runs on your device.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-assets.mjs && vite --port 5330 --strictPort",
    "build": "node scripts/copy-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --port 5331 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "5.3.0",
    "@huggingface/transformers": "3.8.1",
    "@mozilla/readability": "0.6.0",
    "fflate": "0.8.3",
    "mp4-muxer": "5.2.2",
    "pdfjs-dist": "6.4.299",
    "phonemizer": "1.2.1",
    "signalsmith-stretch": "1.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
